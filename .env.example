# Local, non-secret defaults. Copy to .env and adjust as needed.
DATABASE_PATH=data/nifty_options.duckdb
LOG_LEVEL=INFO
# Optional HTTPS incoming-webhook URL; keep private in .env/deployment secrets.
ALERT_WEBHOOK_URL=
MAX_CSV_BYTES=104857600
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_ATTEMPTS=4
HTTP_MIN_INTERVAL_SECONDS=1
HTTP_MAX_RESPONSE_BYTES=26214400
SCHEDULER_ENABLED=false
SCHEDULER_TIME=18:15
OPTIONS_CSV=data/raw/options.csv
PRICES_CSV=data/raw/prices.csv

